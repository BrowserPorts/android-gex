# The oracle's own addition to init's configuration, for init.sh's boot:
# bound at /init.ranchu.rc, which the image's init.rc imports
# (/init.${ro.hardware}.rc) and the image does not have, so nothing of the
# image's is replaced.
#
# What Android logs goes to logd, which nobody reads in a boot without a
# screen or adb. gex_logcat copies it, as it comes, to /gexlog/logcat.txt:
# a directory of the host's that init.sh binds there, so the log is the
# host's to read during the boot and after it (the reasons odrefresh,
# odsign and the services after them give for what they do). Not to the
# kernel log: a write there is one record of at most 1024 bytes, and an
# entry can be longer. logcat's own complaints go to the kernel log
# (stdio_to_kmsg).

# This device is slow by construction (every program translated, the
# first run of each translated afresh), as a translated emulator is, so it
# says so as such devices do: ro.hw_timeout_multiplier scales the time
# Android's daemons give each other (android::base::HwTimeoutMultiplier).
# netd gives its iptables-restore 50 polls of 100 ms times it to answer, and
# the first one of a boot loads and translates every iptables extension
# while the zygote and dozens of services start and translate beside it
# (at 10, boots b62 and b71 still ran out of time; alone it answers in 7 s
# of the guest's time, cold). Set before anything reads it; the image's
# build properties do not set it.
on early-init
    setprop ro.hw_timeout_multiplier 30
    # ART's JIT is on, as the image has it (dalvik.vm.usejit). It was off
    # while the zygote's two views of its JIT memfd were copies here (boot
    # b81's "Expected invalid entry"); they are one memory since 55ce597e8,
    # and code the JIT writes again while it runs is translated again
    # since c29d182a0 (jitrace.c). A boot configuration can still turn it
    # off (androidboot.gex.usejit = "false", below): every method ART's
    # JIT compiles is new machine code, which gex translates and compiles
    # in turn, every boot.
    # The display's density, which the emulator's host gives
    # surfaceflinger (qemu.sf.lcd_density, read before ro.sf.lcd_density;
    # the image's build properties set neither): the emulator's 420 for a
    # 1080-wide phone, as GEX_VIRTIO_GPU=1080x1920 makes the display.
    setprop qemu.sf.lcd_density 420
    # No compiling at first boot. Its dexopt of every package (116, by
    # dex2oat64 run translated, on system_server's main thread in
    # UpdatePackagesIfNeeded) outlasted boot b121's two hours, and with /data
    # in memory (boot.sh without DATA) every boot is a first boot. `skip` is
    # ArtService's compiler filter for none (pm.dexopt.<reason>); the
    # packages run from their dex, and are compiled later as a device
    # configured so would compile them: with /data kept (DATA), what is
    # compiled then is there at the next boot.
    setprop pm.dexopt.first-boot skip

# With guest rendering (bootconfig.swiftshader: minigbm's buffers, the
# composer drawing them itself) the composer finds its displays through
# DRM, the virtio-gpu's connector, as a device with no host renderer has it
# configured. With the image's own graphics (bootconfig: gralloc ranchu,
# gfxstream's host composing) it asks the emulator's host, the property
# unset; told to look in DRM there, it finds no display and SurfaceFlinger
# aborts with "Can't create AidlComposerClient".
on early-init && property:ro.boot.hardware.gralloc=minigbm
    setprop ro.vendor.hwcomposer.display_finder_mode drm

on post-fs
    start gex_logcat

service gex_logcat /system/bin/logcat -b main,system,crash -v threadtime -f /gexlog/logcat.txt -r 1048576
    user logd
    group log
    disabled
    stdio_to_kmsg
    seclabel u:r:logpersist:s0

# ART's JIT off for one boot (early-init above says why one might): a boot
# configuration with androidboot.gex.usejit = "false".
on early-init && property:ro.boot.gex.usejit=false
    setprop dalvik.vm.usejit false
